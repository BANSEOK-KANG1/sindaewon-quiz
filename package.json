{
  "name": "sindaewon-quiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/curate-content.js",
    "build": "vite build",
    "postbuild": "node scripts/prepare-sites-build.js",
    "preview": "vite preview",
    "import": "node scripts/import-questions.js && node scripts/curate-content.js",
    "import:csv": "node scripts/import-csv.js && node scripts/curate-content.js",
    "curate": "node scripts/curate-content.js",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "enrich:english": "python3 scripts/enrich-english-choice-notes.py"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/status-bar": "^8.0.2",
    "lucide": "^0.475.0"
  }
}
